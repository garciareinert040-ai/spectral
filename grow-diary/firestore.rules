rules_version = '2';

// =============================================================================
// Regras de segurança do Cloud Firestore — Diário de Cultivo
// Cada usuário só lê/escreve os PRÓPRIOS dados (request.auth.uid == uid).
// Cole isto em: Console Firebase → Firestore Database → aba "Regras" → Publicar.
// =============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // Documento de config do usuário: users/{uid}
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Registros diários: users/{uid}/entries/{data}
      match /entries/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Tudo o mais é negado por padrão.
  }
}
